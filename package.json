{
  "name": "xtranslate",
  "productName": "Xtranslate",
  "version": "0.1.6",
  "description": "中英互译输入法：热键呼出，打字即译，口语化",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test ./test/*.test.js",
    "setup": "node scripts/setup.js",
    "dist": "electron-builder --win nsis portable --x64 --publish never",
    "dist:portable": "electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "koffi": "3.3.2"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.xtranslate.app",
    "productName": "Xtranslate",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!docs/**",
      "!test/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Xtranslate",
      "artifactName": "Xtranslate-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Xtranslate-portable.${ext}",
      "requestExecutionLevel": "user"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ]
  }
}
